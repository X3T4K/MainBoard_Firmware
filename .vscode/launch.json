{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SWDP (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd", // Cambiato da stlink a openocd
            "executable": "${command:cmake.launchTargetPath}",
            "device": "STM32U575xx",
            "liveWatch":{
                "enabled": true,
                "samplesPerSecond": 4
            },
            "svdFile": "${workspaceFolder}/STM32U575.svd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32u5x.cfg" // Configurazione specifica per serie U5
            ],
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 72000000, // Deve essere l'HCLK reale
                "swoFrequency": 2000000,
                "runInTerminal": true,
                "source": "probe",
                "decoders": [
                    { "type": "console", "label": "ITM Log", "port": 0 }
                ]
            }
        }
    ]
}
 